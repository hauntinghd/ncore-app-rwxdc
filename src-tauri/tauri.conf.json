{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NCore",
  "version": "11.7.116",
  "identifier": "com.nyptid.ncore",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:tauri:web",
    "frontendDist": "../dist-tauri"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NCore",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 680,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ4NDMwRUZBMDUwNDA1MTgKUldRWUJRUUYrZzVEMkdnR1k5eXpqV2k3c0RhdGc0czZXb2tNdHRxQ3lpY0FaYm9FTC9KU3hIK1cK",
      "endpoints": [
        "https://ncore.nyptidindustries.com/updates/tauri/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../electron/assets/ncore-icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
