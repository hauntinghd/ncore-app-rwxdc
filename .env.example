# NCore environment — copy to .env and fill in.
# .env is gitignored; this template is committed for new developer onboarding.

# === Required ===
# Supabase project URL. Get from https://supabase.com/dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon key. Public on purpose (guarded by RLS).
VITE_SUPABASE_ANON_KEY=<supabase-anon-jwt>

# Agora App ID. Public on purpose. Get from Agora Console -> Project Management.
VITE_AGORA_APP_ID=<agora-app-id>

# Agora token function name (defaults to 'agora-token' if unset).
VITE_AGORA_TOKEN_FUNCTION=agora-token

# Active RTC provider. 'agora' is canonical; 'livekit' is kept as a swappable backend.
VITE_RTC_PROVIDER=agora

# Direct-message E2E encryption is enabled by default when unset.
# Only set this to false for local emergency debugging; production should not
# allow readable direct-message content to be written when peer keys are ready.
# VITE_ENABLE_E2E_DMS=false

# === Optional ===
# If set, the client prefers real Agora tokens and refuses to fall back to
# unauthenticated joins. Only flip this after the agora-token function is
# deployed AND the Agora project is in App-ID + App-Certificate mode.
# VITE_AGORA_REQUIRE_TOKEN=true
# VITE_AGORA_ALLOW_UNAUTH_JOIN=false

# Static Agora token — only used for ad-hoc testing. Leave blank in real deploys.
# VITE_AGORA_TEMP_TOKEN=

# RunPod backend probe (used by the AI features in DMs).
# VITE_RUNPOD_HTTP_URL=https://<runpod-endpoint>
# VITE_ENABLE_RUNPOD_PROBE=1

# Optional remote error sink. If set, runtime errors are POSTed here as JSON.
# Any receiver works (Sentry HTTP relay, Discord webhook, LogSnag, etc.).
# Rate-limited client-side to 30 errors / minute / tab.
# VITE_ERROR_WEBHOOK_URL=

# Default device push token for testing push notifications in dev.
# VITE_DEFAULT_DEVICE_TOKEN=
# VITE_DEFAULT_DEVICE_PLATFORM=android
